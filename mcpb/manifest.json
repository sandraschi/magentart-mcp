{
  "manifest_version": "0.2",
  "name": "magentart-mcp",
  "version": "0.2.0",
  "description": "MCP server for Google Magenta RealTime 2 music generation",
  "author": { "name": "sandraschi" },
  "server": {
    "type": "python",
    "entry_point": "src/magentart_mcp/server.py",
    "mcp_config": {
      "command": "uv",
      "args": ["run","--directory","${PWD}","python","-m","magentart_mcp"],
      "env": {
        "PYTHONPATH": "${PWD}/src",
        "PYTHONUNBUFFERED": "1"
      }
    }
  },
  "tools": [
    { "name": "magentart_ops", "description": "magentart_ops" },
    { "name": "magentart_agentic_workflow", "description": "magentart_agentic_workflow" },
    { "name": "health", "description": "health" }
  ]
}
